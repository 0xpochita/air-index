# Copy to .env and fill in. Never commit the filled file.

# Sepolia RPC. Leave empty to fall back to a public node, which rate limits
# on writes and wide log queries.
SEPOLIA_RPC_URL=
NEXT_PUBLIC_SEPOLIA_RPC_URL=

# Private key used by the scripts in scripts/ to sign Sepolia transactions.
# Use a throwaway wallet funded from a faucet, never a real one. Read by the
# scripts only, never bundled into the browser.
DEPLOYER_PRIVATE_KEY=

# Written by scripts/bootstrap.ts once the airindex.eth registry is deployed.
NEXT_PUBLIC_AIR_INDEX_REGISTRY=
NEXT_PUBLIC_AIR_INDEX_FROM_BLOCK=

# Written by scripts/deploy-registrar.ts. The contract that holds REGISTRAR and
# lets any wallet publish an index from the browser.
NEXT_PUBLIC_AIR_INDEX_REGISTRAR=

# Token used to push from this workspace.
GITHUB_TOKEN=
